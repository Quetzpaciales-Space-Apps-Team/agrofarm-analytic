  "validation": {
    "split": "leave one whole year out",
    "benchmark": "climatology: the quantiles of the training anomalies for every row",
    "rule": "Leave one whole year out. The model works only if the pooled pinball loss is at least 5 % lower than climatology, the skill is positive in at least 60 % of the years, and it is positive in at least one El Nino year and one La Nina year.",
    "note": "Cell normals are computed without the held-out year. The saved model is refit on all years."
  },
