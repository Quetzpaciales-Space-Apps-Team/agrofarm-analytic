  "model_version": "ndvi-peak-experimental-0.1.0",
  "status": "experimental",
  "purpose": "What-if outlook of cropland greenness under a rainfall, temperature and ENSO scenario, with a range.",
  "target": "seasonal peak NDVI on cropland, as a percentage of the cell's own normal",
  "algorithm": "LightGBM gradient boosting, one quantile model per quantile",
  "quantiles": [
    0.1,
    0.5,
    0.9
  ],
  "features": [
    "rain_anom_pct",
    "rain_early_anom_pct",
