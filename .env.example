# Copy to .env for local development. Never commit .env.
ML_PORT=8081
LOG_LEVEL=INFO
CORE_API_URL=http://core-api:8080
GCS_BUCKET_RAW=agrofarm-raw-local
GCS_BUCKET_CLEAN=agrofarm-clean-local
GCS_BUCKET_MODELS=agrofarm-models-local

# Meteomatics point forecast (data-service, optional). Real values go in services/data/.env
# locally and in Secret Manager on GCP. Never commit them.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
